/*
 * COMFAST CF-XR11 (Wi-Fi 6 AX1800) — MT7621A + MT7915 (DBDC), 16 MB SPI-NOR
 * Flash map, EEPROM offset (Factory 0x0, chip-id 0x7915) and MAC (Factory 0x4)
 * taken directly from the stock flash dump. Template: comfast_cf-e390ax.
 */

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "comfast,cf-xr11", "mediatek,mt7621-soc";
	model = "COMFAST CF-XR11";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;	/* placeholder: verify GPIO */
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status: status {				/* placeholder: verify GPIO */
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
		label-mac-device = &gmac0;
	};
};

&pcie {
	status = "okay";
};

/*
 * MT7915 is on the PCIe1 slot on the CF-E390AX reference wiring.
 * If Wi-Fi does NOT appear after flashing (check `dmesg | grep mt7915`
 * on the serial console), change &pcie1 below to &pcie0 and rebuild.
 */
&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>;
		nvmem-cell-names = "eeprom";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <14000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "config";
				reg = <0x40000 0x10000>;
				read-only;
			};

			partition@50000 {
				label = "factory";
				reg = <0x50000 0x40000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0xe00>;
					};

					macaddr_factory_4: macaddr@4 {
						reg = <0x4 0x6>;
					};
				};
			};

			partition@90000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x90000 0xf70000>;
			};
		};
	};
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_4>;
	nvmem-cell-names = "mac-address";
};

/* Stock swconfig mapped: LAN = switch ports 0-3, WAN = port 4 */
&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan3";
		};

		port@3 {
			status = "okay";
			label = "lan4";
		};

		port@4 {
			status = "okay";
			label = "wan";
		};
	};
};
